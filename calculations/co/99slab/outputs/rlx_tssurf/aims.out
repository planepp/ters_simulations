  -----------------------------------------------------------------------
  
  xc            pbe
  relativistic  atomic_zora scalar
  vdw_ts vdw_params_kind=tssurf
  relax_geometry bfgs 1e-4
  output_level MD_light
  k_grid 1 1 1
  sc_accuracy_rho 1e-08
  use_dipole_correction .true.
  
  ################################################################################
  #
  #  FHI-aims code project
  #  Volker Blum, 2018
  #
  #  Suggested "intermediate" defaults for Ag atom (to be pasted into control.in file)
  #
  ################################################################################
    species        Ag
  #     global species definitions
      nucleus             47
      mass                107.8682
  #
      l_hartree           6
  #
      cut_pot             4.0  2.0  1.0
      basis_dep_cutoff    1e-4
  #
      radial_base         62 7.0
      radial_multiplier   2
      angular_grids specified
        division   0.3947   50
        division   0.7739  110
        division   1.1156  194
        division   1.3117  302
        division   1.5936  434
